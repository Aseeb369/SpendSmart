@model List<SpendSmart.Models.CategorySummary>

    <div class="text-center">
        <h1 class="display-4">Expense Overview</h1>
    </div>

    <table class="table table-bordered mt-4">
        <thead>
            <tr>
                <th>Category</th>
                <th>Total Amount Spent</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
        {
            <tr>
                <td>@item.Category</td>
                <td>₹ @item.TotalAmount</td>
            </tr>
        }
        </tbody>
    </table>
